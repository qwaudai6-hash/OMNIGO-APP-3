# ──────────────────────────────────────────────────────────────
#  OMNIGO BACKEND — Railway Production Environment Template
#  Copy these values into Railway Dashboard → Variables.
#  NEVER commit this file with real secrets.
# ──────────────────────────────────────────────────────────────

# ── Infrastructure (Railway auto-injected references) ─────────
# Railway Postgres plugin → auto-injected as ${{Postgres.DATABASE_URL}}
# Railway Redis plugin   → auto-injected as ${{Redis.REDIS_URL}}
DATABASE_URL="${{Postgres.DATABASE_URL}}"
DB_WRITER_DSN="${{Postgres.DATABASE_URL}}"
DB_READER_DSN="${{Postgres.DATABASE_URL}}"
REDIS_ADDRS="${{Redis.REDIS_URL}}"

# ── Kafka (Railway auto-injected from Kafka plugin) ────────────
# IMPORTANT: Kafka plugin must be added to the Railway project
# and linked to this service. Then set this variable:
KAFKA_BROKERS="kafka.railway.internal:9092"
# ── Neo4j AuraDB ─────────────────────────────────────────────
# Get from AuraDB console: https://console.neo4j.io
NEO4J_URI="neo4j+s://32442466.databases.neo4j.io"
NEO4J_USER="32442466"
NEO4J_PASSWORD="AZtq1wLwibLswVAsgjpZuMGi4bdRH1zCAcQmEUEme3c"

# ── OSRM (external hosted or Railway private) ─────────────────
# For production OSRM, deploy an OSRM container on Railway and use its internal URL
OSRM_URL="http://osrm.railway.internal:5000"
OSRM_BASE_URL=http://osrm.railway.internal:5000

# ── Message Broker ──────────────────────────────────────────
KAFKA_BROKERS="kafka.railway.internal:9092"
# Uncomment these if your Railway Kafka plugin requires authentication
# KAFKA_USER=${{Kafka.KAFKA_USERNAME}}
# KAFKA_PASSWORD=${{Kafka.KAFKA_PASSWORD}}

# ── JWT Secrets ─────────────────────────────────────────────
# Generate ALL of these with:  openssl rand -base64 64
# The monolith will FATAL on startup if any are missing.
JWT_SECRET_KEY="csiPLQIJqstuH6rIa6ulOdjl30RMYqwfk2cwTPoj2nAVHykMdWixUJnwVt6NovAyUDMqLoryPxQOSPM6jr6MlQ=="
JWT_ISSUER="omnigo-platform"

# ── Ledger / Internal Signing ───────────────────────────────
# Generate with:  openssl rand -base64 32
HMAC_SECRET="XLZg8xSIgUncVPqiObww9hRzOVc5Y68E+5xjB0+ac7c="

# ── Admin API Key Encryption (AES-256-GCM) ──────────────────
# Generate with:  openssl rand -base64 32
ADMIN_API_KEY_ENCRYPTION_KEY="/N6AKevpb5gqQ7TpEndfYJ9bHvBU54hQV8I2w+ealsQ="

# ── Service Ports (loopback inside Railway container) ─────────
PORT=8000
AUTH_SERVICE_PORT="9000"
VENDOR_SERVICE_PORT=9002
PRODUCT_SERVICE_PORT=9001
ADMIN_SERVICE_PORT=9007
DELIVERY_SERVICE_PORT=9003
RIDE_SERVICE_PORT=9004
ORDER_SERVICE_PORT=9005
WS_GATEWAY_PORT=9008
PAYMENT_ORCHESTRATOR_PORT=9006
NOTIFICATION_SERVICE_PORT=8089
EMAIL_SERVICE_PORT="8090"
AI_ENGINE_PORT=8086

# ── Inter-service URLs (Railway private networking) ───────────
AUTH_SERVICE_URL="http://127.0.0.1:9000"
PRODUCT_SERVICE_URL="http://127.0.0.1:9001"
VENDOR_STORE_SERVICE_URL="http://127.0.0.1:9002"
DELIVERY_SERVICE_URL="http://127.0.0.1:9003"
RIDE_SERVICE_URL="http://127.0.0.1:9004"
ORDER_SERVICE_URL="http://127.0.0.1:9005"
PAYMENT_SERVICE_URL="http://127.0.0.1:9006"
ADMIN_SERVICE_URL="http://127.0.0.1:9007"
WEBSOCKET_GATEWAY_URL="http://127.0.0.1:9008"
NOTIFICATION_SERVICE_URL="http://notification-service.railway.internal:8089"
EMAIL_SERVICE_URL="http://email-service.railway.internal:8090"
AI_ENGINE_URL="http://ai-engine.railway.internal:8086"

# ── CORS (MANDATORY in production) ──────────────────────────
# Comma-separated list of allowed Origins.
# In production (APP_ENV=production), empty = FATAL panic.
# Development: set APP_ENV=development to allow reflect-mode.
APP_ENV="production"
CORS_ALLOWED_ORIGINS="https://omnigo-app-production.up.railway.app"

# ── DB Pool Tuning ──────────────────────────────────────────
DB_MAX_CONNS_WRITER=10
DB_MIN_CONNS_WRITER=2
DB_MAX_CONNS_READER=20
DB_MIN_CONNS_READER=4
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# ── ClickHouse Analytics ────────────────────────────────────
# Railway ClickHouse plugin → auto-injected via ${{ClickHouse.CLICKHOUSE_URL}}
# Or set manually from Railway ClickHouse plugin variables:
CLICKHOUSE_ADDR="clickhouse.railway.internal:9000"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD="3x4j22220mby3ujtd7w292j5uvgwzbob9sb"
CLICKHOUSE_DATABASE="default"

# ── TigerBeetle Ledger ──────────────────────────────────────
TB_ENABLED="false"
TIGERBEETLE_ADDRESSES="tigerbeetle.railway.internal:3000"

# ── Stripe (production keys) ────────────────────────────────
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── PayFast Pakistan ──────────────────────────────────────────
PAYFAST_MERCHANT_ID=REPLACE_ME
PAYFAST_SECURED_KEY=REPLACE_ME
PAYFAST_MERCHANT_NAME=OMNIGO
PAYFAST_API_URL=https://www.gopayfast.com

# ── JazzCash / EasyPaisa HMAC Salts ───────────────────────────

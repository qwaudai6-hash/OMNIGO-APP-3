EASYPAISA_SALT=REPLACE_ME_openssl_rand_base64_32

# ── Firebase FCM ──────────────────────────────────────────────
FIREBASE_PROJECT_ID=REPLACE_ME
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"

# ──────────────────────────────────────────────────────────────
#  OMNIGO PLATFORM — Environment Configuration Example
#  Copy this file to .env and fill in your values.
#  NEVER commit the actual .env file.
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL (Supabase) ──────────────────────────────────
# Paste your Supabase Direct Connection string below:
DATABASE_URL="${{Postgres.DATABASE_URL}}"

# For Go backend
DB_WRITER_DSN="${{Postgres.DATABASE_URL}}"
DB_READER_DSN="${{Postgres.DATABASE_URL}}"

# ── Redis Cluster ─────────────────────────────────────────────
REDIS_ADDRS="${{Redis.REDIS_URL}}"

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKERS="kafka.railway.internal:9092"
# ── Neo4j (AuraDB) ─────────────────────────────────────────────
NEO4J_URI="neo4j+s://32442466.databases.neo4j.io"
NEO4J_USER="32442466"
NEO4J_PASSWORD="changeme_neo4j_password"

# ── OSRM ──────────────────────────────────────────────────────
# For production OSRM, deploy an OSRM container and use its URL here
OSRM_URL="http://osrm.railway.internal:5000"

# ── JWT Secrets ───────────────────────────────────────────────
# IMPORTANT: Generate a strong secret with: openssl rand -base64 64
# The service WILL CRASH on startup if JWT_SECRET_KEY is not set.
JWT_SECRET_KEY="changeme_generate_with_openssl_rand_base64_64"
JWT_ISSUER="omnigo-platform"

# ── Service Ports (Monolith Internal) ─────────────────────────────
PORT=8000
AUTH_SERVICE_PORT="9000"
PRODUCT_SERVICE_PORT=9001
VENDOR_SERVICE_PORT=9002
DELIVERY_SERVICE_PORT=9003
RIDE_SERVICE_PORT=9004
ORDER_SERVICE_PORT=9005
PAYMENT_ORCHESTRATOR_PORT=9006
ADMIN_SERVICE_PORT=9007
WEBSOCKET_GATEWAY_PORT=9008
NOTIFICATION_SERVICE_PORT=8089
EMAIL_SERVICE_PORT="8090"
AI_ENGINE_PORT=8086

# ── Inter-service URLs (Docker / Railway Private Networking) ────
# In production, set these to Railway private service URLs or use the monolith.
AUTH_SERVICE_URL="http://127.0.0.1:9000"
VENDOR_STORE_SERVICE_URL="http://127.0.0.1:9002"
PRODUCT_SERVICE_URL="http://127.0.0.1:9001"
ADMIN_SERVICE_URL="http://127.0.0.1:9007"
DELIVERY_SERVICE_URL="http://127.0.0.1:9003"
RIDE_SERVICE_URL="http://127.0.0.1:9004"
ORDER_SERVICE_URL="http://127.0.0.1:9005"
PAYMENT_SERVICE_URL="http://127.0.0.1:9006"
WEBSOCKET_GATEWAY_URL="http://127.0.0.1:9008"
AI_ENGINE_URL="http://ai-engine.railway.internal:8086"
NOTIFICATION_SERVICE_URL="http://notification-service.railway.internal:8089"
EMAIL_SERVICE_URL="http://email-service.railway.internal:8090"
SMS_SERVICE_URL="http://sms-service.railway.internal:8091"
SMS_SERVICE_PORT="8091"

# ── Gateway / Public URL ───────────────────────────────────────
# The single public URL Flutter talks to. Used for wallet callbacks.
PUBLIC_BASE_URL="https://omnigo-app-production.up.railway.app"
WALLET_RETURN_URL="https://omnigo-app-production.up.railway.app/api/v1/wallet/callback"

# ── CORS (REQUIRED in production) ──────────────────────────────
# Comma-separated list. In development, empty = "*".
# In production (APP_ENV=production), empty = FATAL panic.
APP_ENV="production"
CORS_ALLOWED_ORIGINS="https://omnigo-app-production.up.railway.app"

# ── DB Pool Tuning ─────────────────────────────────────────────
DB_MAX_CONNS_WRITER=10
DB_MIN_CONNS_WRITER=2
DB_MAX_CONNS_READER=20
DB_MIN_CONNS_READER=4
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# ── ClickHouse Analytics ───────────────────────────────────────
CLICKHOUSE_ADDR="clickhouse.railway.internal:9000"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD="changeme_clickhouse_password"
CLICKHOUSE_DATABASE="default"

# ── TigerBeetle (ledger) ───────────────────────────────────────
TB_ENABLED="false"
TIGERBEETLE_ADDRESSES="tigerbeetle.railway.internal:3000"

# ── Stripe ────────────────────────────────────────────────────
# Get keys from: https://dashboard.stripe.com/apikeys
# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Flutter build: --dart-define=STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── PayFast Pakistan ──────────────────────────────────────────
# Get keys from: https://sandbox.gopayfast.com (sandbox)
# Production: https://www.gopayfast.com
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
# SEPARATE "Hash Key" issued by PayFast for HMAC-SHA256 secured_hash signing.
# NOT the same as SECURED_KEY — signing with the wrong one fails validation
# with "merchant secret not included in the hash".
PAYFAST_HASH_KEY=
PAYFAST_MERCHANT_NAME=
# Gateway endpoint. Canonical name is PAYFAST_BASE_URL; PAYFAST_API_URL is kept
# as a legacy alias the backend also accepts (do not set both).
PAYFAST_BASE_URL=https://ipg.gopayfast.com
# Per-call gateway HTTP timeout in seconds (default 20 if unset)
PAYFAST_GATEWAY_TIMEOUT_SECONDS=20
# Removal date advertised on deprecated legacy PayFast endpoints (HTTP-date).
# Unset = rolling one-year-out date.
PAYFAST_LEGACY_SUNSET_DATE=
# Trusted web origin allowed to receive window.postMessage results from the
# 3DS popup/webview (falls back to first CORS_ALLOWED_ORIGINS entry; "*"
# only as last-resort dev fallback).
PAYFAST_WEB_ORIGIN=

# ── JazzCash / EasyPaisa ─────────────────────────────────────
# HMAC salts for webhook signature verification
JAZZCASH_SALT=default_salt_2026
# Deprecated alias for JAZZCASH_SALT. Set one of them, not both.
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_SALT=sandbox_salt_123

# ── Firebase (FCM) ────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── MinIO / S3 Compatible Storage ─────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=omnigo-uploads

# ── Map Service (MapLibre / MapTiler now, self-hosted later) ──
MAPLIBRE_API_KEY=your_maptiler_key_here
MAPLIBRE_STYLE_URL=https://api.maptiler.com/maps/streets/style.json?key=${MAPLIBRE_API_KEY}
MAP_SERVICE_PORT=9010
MAP_SERVICE_URL=http://127.0.0.1:9010

# ── Self-hosted Map Stack (Photon + TileServer GL) ──
# When the open-source stack is fully provisioned, set MAPLIBRE_STYLE_URL
# to point at TileServer GL and MAPLIBRE_API_KEY to empty.
PHOTON_URL=http://omnigo-photon:2322
TILESERVER_GL_URL=http://omnigo-tileserver-gl:8080
# Public Nominatim is used as a fallback if Photon is unreachable.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=OMNIGOApp/1.0 (geocode proxy)

# ── Pakistan SMS Gateway (local provider primary, Twilio fallback) ──
SMS_GATEWAY_TYPE=pakistan_local
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_SENDER=OMNIGO
SMS_OTP_TEMPLATE=Your OMNIGO verification code is {otp}. Do not share it with anyone.
SMS_LOCAL_GATEWAY_TIMEOUT=10s

# Twilio fallback (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Payment Gateways (LIVE credentials loaded from env only) ───
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# PayFast PK
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_MERCHANT_NAME=
# Canonical gateway endpoint var (PAYFAST_API_URL accepted as legacy alias)
PAYFAST_BASE_URL=https://ipg.gopayfast.com

# JazzCash
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_API_URL=https://payments.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform
# Hosted-checkout endpoint used by the wallet service (sandbox by default —
# override with the production URL in production).
JAZZCASH_CHECKOUT_URL=https://sandbox.jazzcash.com.pk/CustomerAPI/DOTransaction

# EasyPaisa
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_API_URL=https://easypay.easypaisa.com.pk/easypay/Index.jsf
# Hosted-checkout endpoint used by the wallet service (sandbox by default —
# override with the production URL in production).
EASYPAISA_CHECKOUT_URL=https://sandbox.easypaisa.com.pk/api/v1/hosted

# ── Service Bind Host ─────────────────────────────────────────
# 127.0.0.1 (default) is correct for the monolith deployment where the proxy
# and child services share one container. Set BIND_HOST=0.0.0.0 when running
# any individual service in its own container (per-service Railway/K8s mode),
# otherwise the gateway cannot reach it.
BIND_HOST=127.0.0.1

# Cash on Delivery Escrow
COD_ESCROW_ENABLED=true
COD_ESCROW_HOLD_HOURS=72

# ── MinIO / S3 Compatible Storage (KYC docs, proof photos) ─────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=omnigo-uploads
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/omnigo-uploads

# ── API Base URLs ─────────────────────────────────────────────
API_BASE_URL=https://omnigo-app-production.up.railway.app
ADMIN_API_BASE_URL=https://omnigo-app-production.up.railway.app
WS_URL=wss://omnigo-app-production.up.railway.app/ws
PUBLIC_GATEWAY_URL=https://omnigo-app-production.up.railway.app

# ── AI Engine ─────────────────────────────────────────────────
AI_ENGINE_URL="http://ai-engine.railway.internal:8086"

# --- Added by automated update ---
NEO4J_DATABASE="32442466"
AURA_INSTANCEID="32442466"
AURA_INSTANCENAME="OMNIGO APP"
HMAC_SECRET="changeme_generate_with_openssl_rand_base64_32"
ADMIN_API_KEY_ENCRYPTION_KEY="changeme_generate_with_openssl_rand_base64_32"
SERVICE_NAME="monolith"
